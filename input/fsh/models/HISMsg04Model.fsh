// 表15 HISMsg04：通報單送驗新增作業回應資料結構(HISMsg04)之資料模型
// 本檔由欄位對應定義產生；元素名稱即原 JSON 欄位名稱(保留大小寫)。
Logical: HISMsg04Model
Id: HISMsg04Model
Title: "通報單送驗新增作業回應資料結構(HISMsg04)之資料模型"
Description: "NIDRS 表15 傳染病通報單送驗新增作業結構表-回應資料結構(HISMsg04)之資料模型。"
* ^version = "0.1.0"
* ^status = #draft
* SAMPLE_RESULT 1..1 BackboneElement "通報單送驗新增結果" "通報單送驗新增結果。"
* SAMPLE_RESULT.Success 1..1 boolean "處理狀態" "處理狀態；true:成功、false:失敗。原規格資料型態：bool。"
* SAMPLE_RESULT.Success ^example.label = "範例"
* SAMPLE_RESULT.Success ^example.valueBoolean = true
* SAMPLE_RESULT.Message 0..1 string "處理訊息" "處理訊息(原規格未提供說明)。原規格資料型態：String。"
* SAMPLE_RESULT.Exception 0..1 string "例外訊息" "例外訊息(原規格未提供說明)。原規格資料型態：String。"
* SAMPLE_RESULT.ReturnData 0..1 BackboneElement "送驗清單" "成功時，送驗清單如下。"
* SAMPLE_RESULT.ReturnData.SAMPLE 0..1 BackboneElement "送驗單" "送驗單。"
* SAMPLE_RESULT.ReturnData.SAMPLE.Report 1..1 string "法傳通報單編號" "法傳通報單編號(原規格未提供說明，依 EMRMsg04 同名欄位)。原規格資料型態：String。"
* SAMPLE_RESULT.ReturnData.SAMPLE.Report ^example.label = "範例"
* SAMPLE_RESULT.ReturnData.SAMPLE.Report ^example.valueString = "1140300012345"
* SAMPLE_RESULT.ReturnData.SAMPLE.BarCode 1..1 string "送驗單編號" "送驗單編號；送驗時未填者為系統自動編號(15碼數字)。原規格資料型態：String。"
* SAMPLE_RESULT.ReturnData.SAMPLE.BarCode ^example.label = "範例"
* SAMPLE_RESULT.ReturnData.SAMPLE.BarCode ^example.valueString = "202508030000001"
* SAMPLE_RESULT.ReturnData.SAMPLE.HOSPITAL_SAMPLING_NO 0..1 string "院內檢體編號" "院內檢體編號(原規格未提供說明，依 EMRMsg04 同名欄位)。原規格資料型態：String。"
* SAMPLE_RESULT.ReturnData.SAMPLE.ISCORPSEDISSECTION 0..1 string "屍體解剖" "屍體解剖(原規格未提供說明，依 EMRMsg04 同名欄位)。原規格資料型態：String。"
* SAMPLE_RESULT.ReturnData.SAMPLE.SAMPLE_TYPE 1..1 string "檢體類別" "檢體類別(原規格未提供說明，依 EMRMsg04 同名欄位)。原規格資料型態：String。"
* SAMPLE_RESULT.ReturnData.SAMPLE.SAMPLE_TYPE_OTHER 0..1 string "其他檢體備註說明" "其他檢體備註說明(原規格未提供說明，依 EMRMsg04 同名欄位)。原規格資料型態：String。"
* SAMPLE_RESULT.ReturnData.SAMPLE.DISEASE 1..1 string "送驗疾病代碼" "送驗疾病代碼(原規格未提供說明，依 EMRMsg04 同名欄位)。原規格資料型態：String。"
* SAMPLE_RESULT.ReturnData.SAMPLE.DISEASE_OTHER 0..1 string "其他送驗疾病" "其他送驗疾病說明(原規格未提供說明，EMRMsg04 無此欄位)。原規格資料型態：String。"
* SAMPLE_RESULT.ReturnData.SAMPLE.DRUG_BEFORE_SAMPLING 0..1 string "採檢前投藥情形" "採檢前投藥情形(原規格未提供說明，依 EMRMsg04 同名欄位)。原規格資料型態：String。"
* SAMPLE_RESULT.ReturnData.SAMPLE.COMMENTS 0..1 string "個案備註" "個案備註(原規格未提供說明，依 EMRMsg04 同名欄位)。原規格資料型態：String。"
* SAMPLE_RESULT.ReturnData.SAMPLE.REQUESTER 1..1 string "送驗人員" "送驗人員(原規格未提供說明，依 EMRMsg04 同名欄位)。原規格資料型態：String。"
* SAMPLE_RESULT.ReturnData.SAMPLE.SAMPLING_HOSPITAL 1..1 string "送驗單位代碼" "送驗單位代碼(原規格未提供說明，依 EMRMsg04 同名欄位)。原規格資料型態：String。"
* SAMPLE_RESULT.ReturnData.SAMPLE.SAMPLING_HOSPITAL_EMAIL 1..1 string "送驗單位電子信箱" "送驗單位電子信箱(原規格未提供說明，依 EMRMsg04 同名欄位)。原規格資料型態：String。"
* SAMPLE_RESULT.ReturnData.SAMPLE.RECEIVED_UNIT_TYPE 1..1 string "指定收件單位類型" "指定收件單位類型(原規格未提供說明，依 EMRMsg04 同名欄位)。原規格資料型態：String。"
* SAMPLE_RESULT.ReturnData.SAMPLE.RECEIVED_UNIT 1..1 string "指定收件單位代碼" "指定收件單位代碼(原規格未提供說明，依 EMRMsg04 同名欄位)。原規格資料型態：String。"
* SAMPLE_RESULT.ReturnData.SAMPLE.SAMPLED_DAY 1..1 string "檢體採檢日" "檢體採檢日(原規格未提供說明，依 EMRMsg04 同名欄位)。原規格資料型態：String。"
* SAMPLE_RESULT.ReturnData.SAMPLE.CREATE_DAY 1..1 string "送驗單建立日" "送驗單建立日(原規格未提供說明)。原規格資料型態：String。"
* SAMPLE_RESULT.ReturnData.SAMPLE.SAMPLED_TIMES 1..1 string "採檢次數" "採檢次數(原規格未提供說明，EMRMsg04 無此欄位)。原規格資料型態：String。"

Mapping: HISMsg04ModelToFHIR
Id: nidrs-to-fhir
Title: "NIDRS JSON → FHIR"
Description: "HISMsg04 JSON 欄位與本 IG FHIR R4 Profile 元素之對應；格式為「Profile Id: FHIR 元素路徑」，註解為轉換說明。"
Source: HISMsg04Model
Target: "http://hl7.org/fhir/R4"
* -> "Bundle-nidrs-response: Bundle；MessageHeader-nidrs-response: MessageHeader" "MessageHeader.eventCoding = CDCMessageEvent#HISMsg04"
* SAMPLE_RESULT -> "Bundle-nidrs-response: Bundle" "Bundle-nidrs-response 一則(MessageHeader.eventCoding = HISMsg04)"
* SAMPLE_RESULT.Success -> "MessageHeader-nidrs-response: MessageHeader.response.code" "true→ok；false→fatal-error"
* SAMPLE_RESULT.Message -> "OperationOutcome-nidrs: OperationOutcome.issue.details.text" "失敗時建立 OperationOutcome-nidrs(issue.severity = error)；成功時可省略或以 severity = information 表達"
* SAMPLE_RESULT.Exception -> "OperationOutcome-nidrs: OperationOutcome.issue.diagnostics" "直接對應"
* SAMPLE_RESULT.ReturnData -> "Bundle-nidrs-response: Bundle.entry[serviceRequest]；Bundle-nidrs-response: Bundle.entry[specimen]" "成功時回傳之送驗單"
* SAMPLE_RESULT.ReturnData.SAMPLE -> "ServiceRequest-nidrs-sample: ServiceRequest；Specimen-nidrs: Specimen；MessageHeader-nidrs-response: MessageHeader.focus" "回應 Bundle 不另附 Patient、Practitioner、Organization：ServiceRequest/Specimen.subject 以 identifier(個案證號)參照，requester/performer 以 contained 資源表達"
* SAMPLE_RESULT.ReturnData.SAMPLE.Report -> "ServiceRequest-nidrs-sample: ServiceRequest.supportingInfo[report].identifier.value" "以 identifier(system = nidrs-report-id)參照"
* SAMPLE_RESULT.ReturnData.SAMPLE.BarCode -> "ServiceRequest-nidrs-sample: ServiceRequest.identifier[barcode].value" "疾管署 bar-code(13碼)或系統自動編號(15碼數字)；system = https://lims.cdc.gov.tw/"
* SAMPLE_RESULT.ReturnData.SAMPLE.HOSPITAL_SAMPLING_NO -> "Specimen-nidrs: Specimen.identifier.value" "直接對應"
* SAMPLE_RESULT.ReturnData.SAMPLE.ISCORPSEDISSECTION -> "Specimen-nidrs: Specimen.extension[autopsy].valueBoolean" "0→false、1→true"
* SAMPLE_RESULT.ReturnData.SAMPLE.SAMPLE_TYPE -> "Specimen-nidrs: Specimen.type.coding.code" "system = CodeSystem cdc-specimen-type"
* SAMPLE_RESULT.ReturnData.SAMPLE.SAMPLE_TYPE_OTHER -> "Specimen-nidrs: Specimen.type.text" "置於同一 CodeableConcept 之 text"
* SAMPLE_RESULT.ReturnData.SAMPLE.DISEASE -> "ServiceRequest-nidrs-sample: ServiceRequest.reasonCode.coding.code" "以逗號拆分，每一疾病一個 reasonCode(system = CodeSystem cdc-test-disease)"
* SAMPLE_RESULT.ReturnData.SAMPLE.DISEASE_OTHER -> "ServiceRequest-nidrs-sample: ServiceRequest.reasonCode.text" "原規格未說明；推定為送驗疾病「其他(0000)」之說明，置於該 reasonCode.text"
* SAMPLE_RESULT.ReturnData.SAMPLE.DRUG_BEFORE_SAMPLING -> "ServiceRequest-nidrs-sample: ServiceRequest.extension[drugBeforeSampling].valueBoolean" "0→false、1→true"
* SAMPLE_RESULT.ReturnData.SAMPLE.COMMENTS -> "ServiceRequest-nidrs-sample: ServiceRequest.note.text" "直接對應"
* SAMPLE_RESULT.ReturnData.SAMPLE.REQUESTER -> "ServiceRequest-nidrs-sample: ServiceRequest.requester；PractitionerRole-nidrs: PractitionerRole.practitioner.display" "回應 Bundle 不附 Practitioner/PractitionerRole，requester 指向 contained PractitionerRole-nidrs，送驗人員姓名填 practitioner.display"
* SAMPLE_RESULT.ReturnData.SAMPLE.SAMPLING_HOSPITAL -> "PractitionerRole-nidrs: PractitionerRole.organization.identifier.value" "同一 contained PractitionerRole 之 organization 以醫事機構代碼(identifier)參照"
* SAMPLE_RESULT.ReturnData.SAMPLE.SAMPLING_HOSPITAL_EMAIL -> "Organization-nidrs-hospital: Organization.telecom.value" "telecom.system = email；回應中可省略(資訊已於送驗時提供)"
* SAMPLE_RESULT.ReturnData.SAMPLE.RECEIVED_UNIT_TYPE -> "ServiceRequest-nidrs-sample: ServiceRequest.performer；Organization-nidrs-lab: Organization.type.coding.code" "performer 指向 contained Organization-nidrs-lab；system = CodeSystem cdc-received-unit-type"
* SAMPLE_RESULT.ReturnData.SAMPLE.RECEIVED_UNIT -> "Organization-nidrs-lab: Organization.identifier.value" "置於同一 contained Organization-nidrs-lab"
* SAMPLE_RESULT.ReturnData.SAMPLE.SAMPLED_DAY -> "Specimen-nidrs: Specimen.collection.collectedDateTime" "依實際回傳格式(yyyyMMdd 或 yyyy/MM/dd)轉為 yyyy-MM-dd"
* SAMPLE_RESULT.ReturnData.SAMPLE.CREATE_DAY -> "ServiceRequest-nidrs-sample: ServiceRequest.authoredOn" "依實際回傳格式轉為 FHIR dateTime(含時間時補 +08:00)"
* SAMPLE_RESULT.ReturnData.SAMPLE.SAMPLED_TIMES -> "Specimen-nidrs: Specimen.note.text" "原規格未說明(推定為採檢次數/次別)；本 IG Profile 未定義專屬元素，暫以 Specimen.note.text 記錄"
